# Copy to .env and export before running, or inject via K8s/Docker secrets.
# Do not commit real secrets.

CD_CONFIG=configs/config.yaml

RABBIT_HOST=127.0.0.1
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=guest
RABBIT_VHOST=/

CONSUMER_URL=http://127.0.0.1:8080/consumerDispatch/dispatch

# Admin API bearer token (>= 16 chars). Generate with: openssl rand -hex 32
# ADMIN_TOKEN=
# LOG_LEVEL=info
# LOG_FILE=/var/log/consumer-dispatcher/dispatcher.log
# CONSUMER_HOST_HEADER=app.example.com
